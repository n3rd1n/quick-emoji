# Project npm policy. Never put auth tokens in this file.
registry=https://registry.npmjs.org/

# Lifecycle scripts are the usual malware delivery path (postinstall RCE).
ignore-scripts=true

# Skip versions published in the last 7 days (unit is days, not minutes).
# For an urgent patched release: min-release-age-exclude[]=package-name
min-release-age=7

# Block git, local tarball, and URL deps, including transitive ones.
allow-git=none
allow-file=none
allow-remote=none

package-lock=true
save-exact=true
fund=false
engine-strict=true
